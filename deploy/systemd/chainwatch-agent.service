[Unit]
Description=Chainwatch monitoring agent
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=chainwatch
Group=chainwatch
StateDirectory=chainwatch
StateDirectoryMode=0700
UMask=0077
LoadCredential=config:/etc/chainwatch/agent.json
ExecStart=/usr/local/bin/chainwatch --config=%d/config
Restart=always
RestartSec=5
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
